name: Garak Market Daily Briefing

on:
  schedule:
    # UTC 기준 밤 11시 30분 = 한국 시간 기준 매일 아침 8시 30분
    - cron: '30 23 * * *'
  workflow_dispatch: # 수동 테스트 실행 버튼 유지

jobs:
  run-bot:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: |
          pip install requests google-genai

      - name: Run Market Briefing Script
        env:
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          GONGGONGDATA_API: ${{ secrets.GONGGONGDATA_API }}
        run: |
          python bot.py
